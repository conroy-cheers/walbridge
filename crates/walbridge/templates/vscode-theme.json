  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#{{base03-hex}}"
      }
    },
    {
      "scope": ["string", "constant.other.symbol", "entity.other.inherited-class"],
      "settings": {
        "foreground": "#{{base0B-hex}}"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#{{base09-hex}}"
      }
    },
    {
      "scope": ["keyword", "storage", "storage.type"],
      "settings": {
        "foreground": "#{{base0E-hex}}"
      }
    },
    {
      "scope": ["keyword.operator", "punctuation"],
      "settings": {
        "foreground": "#{{base05-hex}}"
      }
    },
    {
      "scope": ["entity.name.function", "support.function", "variable.function"],
      "settings": {
        "foreground": "#{{base0D-hex}}"
      }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": {
        "foreground": "#{{base0A-hex}}"
      }
    },
    {
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#{{base08-hex}}"
      }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#{{base0C-hex}}"
      }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#{{base0F-hex}}"
      }
    },
    {
      "scope": ["variable", "meta.definition.variable"],
      "settings": {
        "foreground": "#{{base05-hex}}"
      }
    },
    {
      "scope": ["invalid"],
      "settings": {
        "foreground": "#{{base00-hex}}",
        "background": "#{{base08-hex}}"
      }
    }
  ]
}
